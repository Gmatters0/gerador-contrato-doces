# Copie para .env.local (desenvolvimento) ou cadastre na Vercel (produção).
APP_USER=eliane
APP_PASSWORD=troque-esta-senha
# String longa e aleatória, ex.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=troque-por-um-segredo-longo
# Dados da Contratada, em uma única linha (não vão para o repositório).
CONTRATADA_JSON={"nome":"Nome Completo","rg":"00.000.000-0","cpf":"000.000.000-00","cnpj":"00.000.000/0000-00","endereco":"Rua X nº 1, Bairro, Cidade, UF","telefone":"(11) 90000-0000","email":"email@exemplo.com","cidade":"Guarulhos"}
